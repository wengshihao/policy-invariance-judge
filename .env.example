# Copy to .env and fill in your own credentials.
# All scripts in this repository read these two variables only.

# OpenAI-compatible endpoint (any provider that exposes /v1/chat/completions).
PIJ_API_KEY=sk-your-key-here
PIJ_BASE_URL=https://api.openai.com/v1

# Default judge model identifier (any model your endpoint serves).
PIJ_JUDGE_MODEL=gpt-4o-mini

# Default rewrite-generator model. May be the same as the judge.
PIJ_REWRITE_MODEL=gpt-4o-mini
